DATABASE_URL=postgres://kivu:kivu@localhost:5432/kivu?sslmode=disable
TEST_DATABASE_URL=postgres://kivu:kivu@localhost:5432/kivu_test?sslmode=disable

# Development and staging only: production never sets it.
ALLOW_FAKE_DATA=true

# Optional. How to run pg_dump, wherever PostgreSQL is. Without it, a pg_dump on the PATH is used.
# PG_DUMP_COMMAND=pg_dump -h db.example
